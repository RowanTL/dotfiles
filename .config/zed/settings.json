{
  "ssh_connections": [
    {
      "host": "192.168.1.139",
      "projects": [
        {
          "paths": ["/home/rowan"]
        },
        {
          "paths": ["/home/rowan/programming/yolov12"]
        }
      ]
    }
  ],
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash"
    }
  },
  "base_keymap": "VSCode",
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Shades Of Purple"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "helix_mode": true,
  "languages": {
    "Python": {
      "language_servers": ["ruff", "ty"]
      // "language_servers": ["ruff"]
      // "language_servers": ["pyright", "ruff"]
      // Or, if there are other language servers you want to use with Python
      // "language_servers": ["pyright", "ruff"]
    },
    "Nix": {
      "language_servers": ["nil", "!nixd"]
    }
  },
  "lsp": {
    "nil": {
      "binary": {
        "path": "/home/rowan/.nix-profile/bin/nil"
      }
    }
  },
  "show_edit_predictions": false
